@startuml
skinparam monochrome true
skinparam shadowing false
'skinparam defaultFontName "Latin Modern Roman"
skinparam defaultFontSize 12
skinparam classBackgroundColor white
skinparam classBorderColor black
skinparam arrowColor black
hide circle
' ========= V2 =========

' ===== TPG DOMAIN =====
class TPG {
    + name : String
    + dtype : String
    + GP instruction set : List<String>
}
class Team { 
    + id : Integer 
}

class TeamCompiled { 
    + code : String
}

class Instruction {
    + mnemonic : String
    + operands : List<String>
}

TPG "1" *-- "1..*" Team : contains
Team "1" *-- "1..*" TeamCompiled : compiled as
TeamCompiled "1" *-- "1..*" Instruction

' ===== COMPILATION TARGET (assembly level) =====
class ISA {
    + name : String
}
TeamCompiled "1..*" --> "1" ISA : compiled for

' ===== STATIC FEATURES (per compiled binary, ISA-determined) =====
class FeatureSet {
    + values : Map<String, Float>
}
TeamCompiled "1" *-- "1" FeatureSet

' ===== MICROARCHITECTURE =====
class Uarch {
    + name : String
    + abi : String
}
Uarch "1..*" --> "1" ISA : implements

' ===== THE HUB: one measurement = one (TeamCompiled, Uarch) point =====
class TeamMeasurement {
    + latencyAvg : Float
    + latencyStdDev : Float
    + nbMeasurements : Integer
}
TeamCompiled "1" *-- "1..*" TeamMeasurement : measured as
TeamMeasurement "0..*" --> "1" Uarch : on

' ===== TOOLING =====
class Disassembler {
    + parseAssembly(code: String) : List<Instruction>
    + parseLatencyJson(path : String) : TPGLatencyData
}
class FeaturesAnalyzer {
    + analyzeInstructions(instructions : 
    List<Instruction>) : FeatureSet
}
Disassembler   ..> TeamCompiled : parses
Disassembler   ..> Instruction  : produces
FeaturesAnalyzer ..> Instruction  : analyzes
FeaturesAnalyzer ..> FeatureSet : produces

' ===== LATENCY MODEL =====
class RegressionModel {
    + weights : Map<String, Float>
    + bias : Float
}
class Regressor {
    + train(features : List<FeatureSet>, 
    measurements List<TeamMeasurement>) : RegressionModel
    + predict(features : FeatureSet) : Float
}
Regressor ..> RegressionModel : produces
Regressor ..> FeatureSet : takes training data
Regressor ..> TeamMeasurement : takes latency labels

@enduml