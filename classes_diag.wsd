@startuml

' =====================================
' TPG DOMAIN
' =====================================

class TPG {
    + name : String
    + dtype : String
    + GPIS : List<String>
}

class Team {
    + id : Integer
}

class CompiledTeam {
    + code : String
}

class Instruction {
    + mnemonic : String
    + operands : List<String>
}

TPG "1" *-- "1..*" Team : contains
Team "1" *-- "1..*" CompiledTeam : compiled as

' =====================================
' MICROARCHITECTURE
' =====================================

class Uarch {
    + name : String
    + isa : String
    + abi : String
}

CompiledTeam "1..*" --> "1" Uarch : targets

' =====================================
' MEASURED PERFORMANCE
' =====================================

class TeamMeasurement {
    + latencyAvg : Float
    + latencyStdDev : Float
    + count : Integer
}

CompiledTeam "1" *-- "1" TeamMeasurement

' =====================================
' FEATURE EXTRACTION
' =====================================

class FeatureVector {
    + values : Map<String, Float>
}

CompiledTeam "1" *-- "1..*" Instruction
CompiledTeam "1" *-- "1" FeatureVector

class Disassembler {
    + parseTpgFile(path : String) : Map<TeamId, TeamBlock>
    + parseLatencyJson(path : String) : TPGLatencyData
}

class FeaturesAnalyzer {
    + analyzeInstructions(instructions : List<Instruction>) : FeatureVector
}

Disassembler ..> CompiledTeam : parses
Disassembler ..> Instruction : produces
FeaturesAnalyzer ..> Instruction : analyzes
FeaturesAnalyzer ..> FeatureVector : produces

' =====================================
' LATENCY MODEL
' =====================================

class RegressionModel {
    + weights : Map<String, Float>
    + bias : Float
}

class Regressor {
    + train(features : List<FeatureVector>, latencies : List<Float>) : RegressionModel
    + predict(features : FeatureVector) : Float
}

Regressor ..> RegressionModel : produces
Regressor ..> FeatureVector : takes training data
Regressor ..> TeamMeasurement : takes latency labels

@enduml
